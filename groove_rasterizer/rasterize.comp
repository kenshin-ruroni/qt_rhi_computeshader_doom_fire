    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 7. INCORPORATION SUBTILE ET HARMONIEUSE ---
    // MICRO-AJUSTEMENT : L'absorption bloque désormais 50% max (au lieu de 60%) pour laisser respirer le fond
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.50));

    vec3 smoke_burn_color = base_scene_rgb * 1.3;
    vec3 smoke_top_color  = vec3(0.26, 0.28, 0.32);
    vec3 fluid_smoke_color = mix(smoke_burn_color, smoke_top_color, smoothstep(0.35, 0.90, real_height));

    // L'injection de matière est également allégée (0.52 au lieu de 0.65)
    vec3 dynamic_smoke_body = fluid_smoke_color * smoke_alpha * 0.52;
    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * mix(0.45, 1.0, real_height));

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}


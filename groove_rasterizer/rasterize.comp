    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(fire_plasma * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(fire_plasma * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(fire_plasma * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 8. INCORPORATION DE LA FUMÉE ---
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.42));

    vec3 smoke_burn_color = base_scene_rgb * 1.3;
    vec3 smoke_top_color  = vec3(0.26, 0.28, 0.32);
    vec3 fluid_smoke_color = mix(smoke_burn_color, smoke_top_color, real_height) * smoke_alpha * 0.52;

    vec3 smoke_scene_rgb = soot_absorption + (fluid_smoke_color * mix(0.45, 1.0, real_height));

    // --- 9. INJECTION ADDITIVE DES ETINCELLES JAUNES DESYNCHRONISEES ---
    vec3 final_rgb = smoke_scene_rgb + (ember_color * ember_mask);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));

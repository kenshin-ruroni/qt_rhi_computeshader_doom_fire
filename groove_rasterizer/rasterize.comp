void main_smoke_not_bad() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5.7 * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. AXE DE HAUTEUR RÉEL ET CISAILLEMENT ---
    float real_height = 1.0 - (float(yy) / float(size.y));

    vec2 noise_uv = vec2(float(x) * 0.015, float(yy) * 0.008 + time * 1.5);
    float wind = smooth_noise2d(noise_uv);
    float force_x = sin(wind * 6.2831 + time * 4.5) * 75.0 * real_height;
    float force_y = cos(wind * 3.1415 - time * 3.5) * 35.0 * real_height;

    // --- 2. CONFIGURATION DES PLANS DE DÉFILEMENT ---
    float heat_scroll = time * 140.0;
    float smoke_scroll = time * 220.0;

    // --- 3. CALCUL DES PLASMAS NATIFS ---
    float fire_plasma = computePlasma(float(x) + force_x * 0.4, float(yy) + heat_scroll, time, rnd, rnd2);
    float smoke_plasma = computePlasma(float(x) + force_x, float(yy) + smoke_scroll + force_y, time, rnd, rnd2);

    // --- 4. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float fire_distortion_x = fire_plasma * 40.0;
    float fire_distortion_y = sin(fire_plasma * 3.1415) * 15.0;

    float fire_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float fire_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(fire_x / float(scale_x)));
    int column = int(floor(fire_yy / float(scale_y)));

    row = clamp(row, 0, int(size_x) - 1);
    column = clamp(column, 0, int(size_y) - 1);

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * int(size_x)]]);

    // --- 5. MODIFICATION CRITIQUE : TRANSITIONS NUANCÉES (SMOOTH DISSIPATION) ---
    float center_x = float(x) / float(size.x);
    float dynamic_cone = mix(0.40, 5.0, real_height);
    float middle_column_mask = exp(-pow((center_x - 0.5) / dynamic_cone, 2.0));

    float smoke_fluid_weight = smoothstep(0.25, 0.85, real_height) * middle_column_mask;

    float dynamic_gain = 2.1 + (rnd * 0.25);
    float raw_pattern = (smoke_plasma * 0.6 + fire_plasma * 0.4 + 0.3) * dynamic_gain;
    float smoke_pattern = clamp(raw_pattern, 0.0, 1.0);

    // NUANÇAGE DE L'ALPHA : L'application d'un profil cosinusoïdal adoucit la transition périphérique.
    // Les franges de la fumée s'estompent de manière extrêmement diffuse vers la transparence.
    float nuanced_alpha = 0.5 - 0.5 * cos(smoke_pattern * 3.14159265);
    float smoke_alpha = nuanced_alpha * smoke_fluid_weight;

    // --- 6. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(fire_plasma * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(fire_plasma * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(fire_plasma * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 7. MUTATION ET ILLUMINATION PROGRESSIVE ---
    vec3 smoke_burn_color = base_scene_rgb * 1.4;
    vec3 smoke_cold_soot  = vec3(0.12, 0.13, 0.15);

    vec3 fluid_smoke_color = mix(smoke_burn_color, smoke_cold_soot, smoothstep(0.35, 0.90, real_height));

    // L'absorption et le corps de la fumée utilisent la transition nuancée
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.92));

    // NUANÇAGE CHROMATIQUE : On atténue doucement l'apport de couleur sur les bords transparents
    vec3 dynamic_smoke_body = fluid_smoke_color * smoke_alpha * smoothstep(0.0, 0.2, smoke_pattern);

    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * mix(0.45, 1.0, real_height));

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}


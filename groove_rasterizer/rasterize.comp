    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(combined_heat * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(combined_heat * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(combined_heat * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    // --- 7. COMPOSITION FINALE ET INJECTION DES GRANDES VOLUTES ---
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);
    vec4 final_logo_effect = doom_logo_color * 2.0;
    if (logo_mask > 0.05) {
        final_logo_effect += plasma_color * 0.7;
    }

    // Assemblage linéaire standard
    vec3 final_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo_effect.rgb;

    // Injection des bulles de fumée élargies dans les teintes de la palette basse (bleu/cyan)
    vec3 smoke_glow = vec3(0.1, 0.4, 1.0) * smooth_voronoi_intensity * central_volute * 2.5;
    final_rgb += smoke_glow;

    // Apport d'un relief incandescent à basse fréquence sur la mèche centrale
    float cell_flicker = sin(time * 5.0 + combined_heat * 10.0) * 0.2 + 0.8;
    final_rgb += 0.25 * vec3(1.0, 0.35, 0.05) * central_volute * cell_flicker;

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 0.0));
}









void main_voronoi() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. FACTEUR DE HAUTEUR ET SCROLLING ASCENDANT ---
    float height_factor = float(yy) / float(size.y);
    float heat_intensity = smoothstep(0.0, 0.8, 1.0 - height_factor);
    float heat_scroll = time * 140.0;

    // --- 2. CALCUL VORONOI MULTI-ÉCHELLE ---
    // On passe des coordonnées UV à Voronoi. Multiplier par la fréquence (ex: 0.02) change la taille des cellules
    vec2 voronoi_uv = vec2(float(x), float(yy) + heat_scroll) * 0.015;


    vec2 voronoi = computeVoronoi(voronoi_uv, time);

    // Inversion de la distance pour avoir le pic d'intensité au centre de la cellule de convection
   float voronoi_intensity = 1.0 - voronoi.x;


    float voronoi_dist = computeSmoothVoronoi(voronoi_uv, time);


    // --- 3. COMBINAISON PLASMA + VORONOI ---
    float plasma = computePlasma(float(x), float(yy) + heat_scroll, time, rnd, rnd2);

    // Le plasma gère les grandes formes de distorsion, Voronoi apporte les micro-turbulences cellulaires
    float combined_heat = mix(plasma, voronoi_intensity - 0.5, 0.4);

    // --- 4. DEFORMATION GEOMETRIQUE DU FEU ---
    float fire_distortion_x = combined_heat * 40.0 * heat_intensity;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0 * heat_intensity;

    uint size_x = fire_matrix[0];
    uint size_y = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float distorted_x = clamp(float(x) + fire_distortion_x, 0.0, float(size.x * scale_x - 1));
    float distorted_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size.y * scale_y - 1));

    int row = int(floor(distorted_x / float(scale_x)));
    int column = int(floor(distorted_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 5. RENDU DU LOGO AVEC ABERRATION ET DISTORSION ---
    int r_offset = int(12.0 * rnd  * sin(0.002 * time * rnd));
    int b_offset = int(-12.0 * rnd2 * sin(0.0025 * time * rnd2));

    float logo_dist_x = fire_distortion_x * 0.6;
    float logo_dist_y = fire_distortion_y * 0.6;

    ivec2 logo_coord_r = ivec2(clamp(int(x) + r_offset + int(logo_dist_x), 0, size.x - 1), clamp(int(yy) + int(logo_dist_y), 0, size.y - 1));
    ivec2 logo_coord_g = ivec2(clamp(int(x) + int(logo_dist_x),            0, size.x - 1), clamp(int(yy) + int(logo_dist_y), 0, size.y - 1));
    ivec2 logo_coord_b = ivec2(clamp(int(x) + b_offset + int(logo_dist_x), 0, size.x - 1), clamp(int(yy) + int(logo_dist_y), 0, size.y - 1));

    float logo_r = imageLoad(doom_logo, logo_coord_r).r;
    float logo_g = imageLoad(doom_logo, logo_coord_g).g;
    float logo_b = imageLoad(doom_logo, logo_coord_b).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);

    // Colorisation du plasma/voronoi pour le logo
    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(combined_heat * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(combined_heat * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(combined_heat * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    // --- 6. COMPOSITION FINALE ET LUEUR CELLULAIRE ---
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);
    vec4 final_logo_effect = doom_logo_color * 2.0;
    if (logo_mask > 0.05) {
        final_logo_effect += plasma_color * 0.7;
    }

    vec3 final_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo_effect.rgb;

    // Utilisation de l'ID unique de la cellule de Voronoi (voronoi.y) pour créer des variations d'éclat thermiques d'une cellule à l'autre
    float cell_flicker = sin(time * 5.0 + voronoi.y * 10.0) * 0.3 + 0.7;
    final_rgb += 0.20 * vec3(1.0, 0.35, 0.05) * voronoi_intensity * cell_flicker * heat_intensity;

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 0.0));
}


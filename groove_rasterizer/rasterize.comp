    vec3 smoke_cold_soot  = vec3(0.06, 0.07, 0.09); // Gris-noir de suie éteinte pour assombrir le plafond

    // Transition chromatique douce : le feu se transmute en suie froide de manière continue
    vec3 fluid_smoke_color = mix(smoke_burn_color, smoke_cold_soot, smoothstep(0.35, 0.90, real_height));

    // L'absorption de la lumière suit la densité analogique du fluide (Fini l'effet calque)
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.92));
    vec3 dynamic_smoke_body = fluid_smoke_color * smoke_alpha;

    // Composition finale unifiée
    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * mix(0.4, 1.0, real_height));

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}



void main_smokde_bof() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. AXE DE HAUTEUR RÉEL ---
    float real_height = 1.0 - (float(yy) / float(size.y));

    // --- 2. DOUBLE OCTAVE DE VORONOI LISSÉ (VENT DE CONVECTION INVISIBLE) ---
    // Fréquence basse (0.006) pour de grandes vagues déformantes fluides qui montent vite
    vec2 smoke_uv1 = vec2(float(x) * 0.006, float(yy) * 0.006 + time * 3.0);
    float smooth_dist1 = computeSmoothVoronoi(smoke_uv1, time);
    float v1 = clamp(1.0 - (smooth_dist1 * 1.1), 0.0, 1.0);

    // Deuxième octave plus petite pour casser la régularité, sans bords durs
    vec2 smoke_uv2 = vec2(float(x) * 0.014, float(yy) * 0.014 + time * 4.5);
    float smooth_dist2 = computeSmoothVoronoi(smoke_uv2, time * 1.3);
    float v2 = clamp(1.0 - (smooth_dist2 * 1.2), 0.0, 1.0);

    // Fusion douce du vent de convection
    float convection_wind = mix(v1, v1 * v2 * 1.5, 0.4);

    // --- 3. PLASMA DE MATIÈRE PROPULSÉ ET DÉFORMÉ ---
    float heat_scroll = time * 140.0;

    // Le Voronoi tord les coordonnées du plasma de manière fluide (Domain Warping)
    // Cela crée le bouillonnement volumineux SANS jamais dessiner de ronds à l'écran.
    float distorted_x = float(x) + (convection_wind * 45.0);
    float distorted_yy_smoke = float(yy) + (time * 160.0) + (sin(convection_wind * 3.1415) * 25.0);

    float plasma = computePlasma(distorted_x, distorted_yy_smoke, time, rnd, rnd2);

    // Signal compacté et lissé (Biais de 0.25 pour l'épaisseur)
    float smoke_pattern = clamp((plasma + 0.25) * 1.8, 0.0, 1.0);

    // --- 4. PLASMA DE DISTORSION ARRIÈRE-PLAN ---
    float combined_heat = mix(plasma, convection_wind - 0.5, 0.35);
    float fire_distortion_x = combined_heat * 40.0;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0;

    // --- 5. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float fire_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float fire_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(fire_x / float(scale_x)));
    int column = int(floor(fire_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 6. ÉTALEMENT MAXIMUM ET OPACIFICATION EN HAUT ---
    float center_x = float(x) / float(size.x);
    float dynamic_cone = mix(0.35, 4.0, real_height);
    float middle_column_mask = exp(-pow((center_x - 0.5) / dynamic_cone, 2.0));

    // Naissance verticale douce
    float smoke_trigger = smoothstep(0.35, 0.55, real_height);

    // ATTÉNUATION CRITIQUE : L'opacité progressive utilise un smoothstep large
    float smoke_alpha = clamp(smoke_pattern * middle_column_mask * smoke_trigger * real_height, 0.0, 1.0);

    // Saturation finale douce au sommet (0.75 max au lieu de 1.0 pour éviter le côté "aplat de craie")
    smoke_alpha = mix(smoke_alpha, 0.75, smoothstep(0.70, 0.98, real_height));

    // --- 7. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(plasma * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(plasma * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(plasma * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 8. EFFET D'ABSORPTION OCCLUSIVE ATTÉNUÉ ---
    // Dissipation douce de la lumière arrière-plan (occlusion à 65% max)
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.65));

    // Teinte gris de suie estompée et intégrée au fond noir
    vec3 smoke_base_color = vec3(0.12, 0.14, 0.18);
    vec3 smoke_top_color  = vec3(0.28, 0.30, 0.33); // Plus sombre pour se fondre discrètement en haut
    vec3 dynamic_smoke_body = mix(smoke_base_color, smoke_top_color, real_height) * (smoke_pattern * middle_column_mask * smoke_trigger);

    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * real_height * 0.50);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}


void main_voronoi_3() {

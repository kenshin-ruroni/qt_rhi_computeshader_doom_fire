#version 460 core

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

// Uniform buffer for triangle data
layout(std430, binding = 0)  buffer TriangleBuffer {
    float vertices[];
};

// Output image
layout(binding = 5,rgba8  ) uniform coherent image2D outputImage;

// Triangle rasterization parameters
struct Triangle {
    vec2 v0, v1, v2;
    uint color;
};

void main() {
    // Calculate pixel coordinates
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;


    vec4 color = vec4(1.0, 0.0, 0.0, 1.0);

    imageStore(outputImage, ivec2(x, y), color);

    ivec2 size = imageSize(outputImage);

    if ( x % 50 <= 5)
    {
        color += vec4(0,0,0.4,0.);
    }
    if ( y % 50 < 5)
    {
        color += vec4(0,0.2,0.,0.);
    }

     imageStore(outputImage,ivec2(x ,y) , color);

}
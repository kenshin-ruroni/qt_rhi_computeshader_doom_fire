    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. AXE DE HAUTEUR RÉEL ---
    float real_height = 1.0 - (float(yy) / float(size.y));

    // --- 2. DOUBLE TEXTURATION DE CONVECTION BRUTE ET LISSE ---
    // Échelle des blobs (0.007) avec défilement rapide vers le haut
    vec2 smoke_uv = vec2(float(x) * 0.007, float(yy) * 0.007 + time * 3.8);

    // Calcul 1 : Les masses de matière (Smooth)
    float smooth_dist = computeSmoothVoronoi(smoke_uv, time);
    float blob_intensity = clamp(1.0 - (smooth_dist * 1.1), 0.0, 1.0);
    float blob_pattern = smoothstep(0.10, 0.65, blob_intensity);

    // Calcul 2 : Les ombres dures de relief (Brute)
    vec2 raw_voronoi_data = computeVoronoi(smoke_uv, time);
    // On extrait les arrêtes dures de la cellule de convection pour sculpter les volumes
    float cell_edges = smoothstep(0.20, 0.75, raw_voronoi_data.x);

    // --- 3. PLASMA THERMIQUE ET DENSIFICATION ---
    float heat_scroll = time * 140.0;
    float plasma = computePlasma(float(x), float(yy) + heat_scroll, time, rnd, rnd2);

    // Épaisseur compacte et lourde du motif de fumée
    float smoke_pattern = clamp((blob_pattern * 0.65 + plasma * 0.35 + 0.25) * 2.2, 0.0, 1.0);

    // --- 4. DISTORSIONS GÉOMÉTRIQUES ARRIÈRE-PLAN ---
    float combined_heat = mix(plasma, blob_pattern - 0.5, 0.40);
    float fire_distortion_x = combined_heat * 40.0;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0;

    // --- 5. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float fire_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float fire_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(fire_x / float(scale_x)));
    int column = int(floor(fire_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 6. ÉTALEMENT MAXIMUM ET OPACIFICATION EN PLAFOND ---
    float center_x = float(x) / float(size.x);
    float dynamic_cone = mix(0.35, 4.0, real_height);
    float middle_column_mask = exp(-pow((center_x - 0.5) / dynamic_cone, 2.0));

    float smoke_trigger = smoothstep(0.35, 0.55, real_height);
    float smoke_alpha = clamp(smoke_pattern * middle_column_mask * smoke_trigger * real_height, 0.0, 1.0);

    // Saturation totale à 100% au sommet absolu de l'image (mur de suie étalé)
    smoke_alpha = mix(smoke_alpha, 1.0, smoothstep(0.65, 0.95, real_height));

    // --- 7. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(plasma * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(plasma * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(plasma * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 8. ABSORPTION DE LA LUMIÈRE PAR LA MATIÈRE SOMBRE ---
    vec3 soot_absorption = base_scene_rgb * (1.0 - smoke_alpha);

    // Teinte charbonneuse gris-suie
    vec3 smoke_base_color = vec3(0.14, 0.16, 0.22);
    vec3 smoke_top_color  = vec3(0.35, 0.36, 0.38);
    vec3 dynamic_smoke_body = mix(smoke_base_color, smoke_top_color, real_height) * (smoke_pattern * middle_column_mask * smoke_trigger);

    vec3 smoke_rgb = soot_absorption + (dynamic_smoke_body * real_height * 0.95);

    // --- 9. MODIFICATION EMBLÉMATIQUE : INTERPOLATION DES OMBRES DE SUIE DURES (EFFET 3D BLOB) ---
    // Les arrêtes de la grille Voronoi ('cell_edges') viennent creuser des ombres noires et profondes
    // directement dans la couleur de la fumée pour lui donner du relief et casser l'effet bain de vapeur.
    float final_shadow_mask = cell_edges * middle_column_mask * smoke_trigger * real_height;
    vec3 shadow_color = vec3(0.005, 0.008, 0.012); // Teinte d'ombre de suie ultra-sombre

    // On applique l'ombre portée (plus violente au sommet de l'image)
    vec3 final_rgb = mix(smoke_rgb, shadow_color, final_shadow_mask * 0.65);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}


void main_turbulent_smoke() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. AXE DE HAUTEUR RÉEL ---
    float real_height = 1.0 - (float(yy) / float(size.y));

    // --- 2. CALCUL DU VORONOI INVISIBLE (VENT DE CONVECTION) ---
    vec2 convection_uv = vec2(float(x) * 0.008, float(yy) * 0.008 + time * 2.5);
    vec2 voronoi = computeVoronoi(convection_uv, time);
    float smooth_convection = clamp(1.0 - voronoi.x, 0.0, 1.0);

    // --- 3. INJECTION DE TURBULENCE ROTATIVE (VORTEX DE PHASE EN HAUT) ---
    // Plus la fumée monte, plus les coordonnées se tordent en vagues asymétriques rapides
    float vortex_strength = 35.0 * real_height;
    vec2 vortex_warp = vec2(
        sin(smooth_convection * 6.2831 + time * 3.0) * vortex_strength,
        cos(smooth_convection * 6.2831 - time * 2.5) * vortex_strength
    );

    // --- 4. PLASMA DE MATIÈRE ULTRA-TURBULENT ---
    float heat_scroll = time * 140.0;
    // On combine les coordonnées natives avec le décalage chaotique du vortex
    float distorted_x = float(x) + vortex_warp.x;
    float distorted_yy_smoke = float(yy) + heat_scroll + vortex_warp.y;

    float plasma = computePlasma(distorted_x, distorted_yy_smoke, time, rnd, rnd2);
    float smoke_pattern = clamp(plasma * 1.4, 0.0, 1.0);

    // --- 5. PLASMA DE DISTORSION ARRIÈRE-PLAN ---
    float combined_heat = mix(plasma, smooth_convection - 0.5, 0.35);
    float fire_distortion_x = combined_heat * 40.0;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0;

    // --- 6. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float fire_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float fire_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(fire_x / float(scale_x)));
    int column = int(floor(fire_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 7. ÉTALEMENT GLOBAL SUR TOUTE LA LARGEUR AU PLAFOND ---
    float center_x = float(x) / float(size.x);

    // MODIFICATION CLÉ : Le cône s'ouvre à 3.0 au sommet.
    // Cela libère totalement la fumée sur l'axe X pour qu'elle s'étale sur les bords de l'écran.
    float dynamic_cone = mix(0.35, 3.0, real_height);
    float middle_column_mask = exp(-pow((center_x - 0.5) / dynamic_cone, 2.0));

    // Seuil de naissance et opacité linéaire
    float smoke_trigger = smoothstep(0.35, 0.55, real_height);
    float opacity_growth = real_height;

    float smoke_alpha = clamp(smoke_pattern * middle_column_mask * smoke_trigger * opacity_growth, 0.0, 1.0) * 0.88;

    // --- 8. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(combined_heat * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(combined_heat * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(combined_heat * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 9. ABSORPTION ET INCORPORATION DU NUAGE ÉVALUÉ ---
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.85));

    vec3 smoke_base_color = vec3(0.14, 0.18, 0.25);
    vec3 smoke_top_color  = vec3(0.48, 0.50, 0.54);
    vec3 dynamic_smoke_body = mix(smoke_base_color, smoke_top_color, real_height) * (smoke_pattern * middle_column_mask * smoke_trigger);

    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * opacity_growth * 0.80);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}



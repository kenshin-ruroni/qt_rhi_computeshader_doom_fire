    // --- 1. FACTEUR DE HAUTEUR ET COORDONNÉES DE DÉFILEMENT ---
    float height_factor = float(yy) / float(size.y);
    // Atténuation progressive vers le haut de l'écran pour éviter que tout tremble uniformément
    float heat_intensity = smoothstep(0.0, 0.8, 1.0 - height_factor);

    // Faire défiler le plasma vers le haut pour simuler le flux thermique montant
    float heat_scroll = time * 150.0;
    float plasma = computePlasma(float(x), float(yy) + heat_scroll, time, rnd, rnd2);

    // --- 2. DÉFORMATION GÉOMÉTRIQUE BI-DIMENSIONNELLE ---
    // Distorsions asymétriques basées sur le plasma et l'intensité locale de la chaleur
    float fire_distortion_x = plasma * 35.0 * heat_intensity;
    float fire_distortion_y = sin(plasma * 2.0) * 15.0 * heat_intensity;

    uint size_x = fire_matrix[0];
    uint size_y = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    // Application des déformations clampées pour la lecture de la FireMatrix
    float distorted_x = clamp(float(x) + fire_distortion_x, 0.0, float(size.x * scale_x - 1));
    float distorted_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size.y * scale_y - 1));

    int row = int(floor(distorted_x / float(scale_x)));
    int column = int(floor(distorted_yy / float(scale_y)));

    // Lecture de la palette du feu distordue en X et en Y
    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 3. RENDU DU LOGO AVEC COMPORTEMENT CHROMATIQUE DYNAMIQUE ---
    int r_offset = int(12.0 * rnd  * sin(0.002 * time * rnd));
    int b_offset = int(-12.0 * rnd2 * sin(0.0025 * time * rnd2));

    // Le logo subit la distorsion thermique de manière un peu plus subtile (0.7) pour rester lisible
    float logo_dist_x = fire_distortion_x * 0.7;
    float logo_dist_y = fire_distortion_y * 0.7;

    ivec2 logo_coord_r = ivec2(clamp(int(x) + r_offset + int(logo_dist_x), 0, size.x - 1), clamp(int(yy) + int(logo_dist_y), 0, size.y - 1));

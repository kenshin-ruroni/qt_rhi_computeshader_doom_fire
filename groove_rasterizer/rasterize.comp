    float ember_spark = smoothstep(random_radius, random_radius - 0.09, dynamic_cell.x);

    float rarity_filter = step(0.997, pcg_hash(uint(dynamic_cell.y * 997.0)));

    float ember_life = smoothstep(0.01, 0.98, 1.0 - real_height);
    float blink = 0.5 + 0.5 * sin(individual_time * 18.0 + dynamic_cell.y);
    float ember_mask = ember_spark * rarity_filter * middle_column_mask * ember_life * blink;

    vec3 ember_color = vec3(2.5, 1.9, 0.2);

    // --- 7. MODIFICATION TECHNIQUE : DISTORSION ET ONDULATION THERMIQUE DU LOGO ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    // MODIFICATION APPLIQUÉE : Au lieu d'utiliser un décalage horizontal fixe,
    // on injecte les ondes du plasma thermique (fire_distortion_x et fire_distortion_y)
    // directement sur les coordonnées d'échantillonnage de la texture.
    float heat_wave_x = fire_distortion_x * 0.8;

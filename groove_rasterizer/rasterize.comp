}



void main_smoke_too_thin() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. AXE DE HAUTEUR RÉEL ---
    // 0.0 tout en bas du feu, 1.0 tout en haut de l'écran
    float real_height = 1.0 - (float(yy) / float(size.y));

    // --- 2. CALCUL DU VORONOI INVISIBLE (VENT DE CONVECTION CYCLIQUE) ---
    // Fréquence basse pour de grandes structures de distorsion de fluide
    vec2 convection_uv = vec2(float(x) * 0.008, float(yy) * 0.008 + time * 2.5);
    vec2 voronoi = computeVoronoi(convection_uv, time);
    float smooth_convection = clamp(1.0 - voronoi.x, 0.0, 1.0);

    // --- 3. PLASMA THERMIQUE DE MATIÈRE ---
    float heat_scroll = time * 140.0;
    // On tord les coordonnées du plasma par le Voronoi pour le faire bouillonner de manière continue
    float distorted_x = float(x) + (smooth_convection * 35.0);
    float plasma = computePlasma(distorted_x, float(yy) + heat_scroll, time, rnd, rnd2);

    // Structure fluide continue (sans aucune forme géométrique de cercle)
    float smoke_pattern = clamp(plasma * 1.4, 0.0, 1.0);

    // --- 4. PLASMA DE DISTORSION ARRIÈRE-PLAN ---
    float combined_heat = mix(plasma, smooth_convection - 0.5, 0.35);
    float fire_distortion_x = combined_heat * 40.0;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0;

    // --- 5. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float fire_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float fire_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(fire_x / float(scale_x)));
    int column = int(floor(fire_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 6. MASQUES ET OPACIFICATION EXPO VERS LE HAUT ---
    float center_x = float(x) / float(size.x);
    // Le cône s'élargit en montant (0.35 -> 0.55) pour simuler la dispersion naturelle de la fumée
    float dynamic_cone = mix(0.35, 0.55, real_height);
    float middle_column_mask = exp(-pow((center_x - 0.5) / dynamic_cone, 2.0));

    // Naissance : La fumée commence au milieu du logo
    float smoke_trigger = smoothstep(0.35, 0.55, real_height);

    // RECTIFICATION OPACITÉ : On utilise une croissance carrée.
    // En bas, l'opacité est nulle. Au milieu, elle est discrète (~0.25).
    // Tout en haut (real_height = 1.0), elle monte à 0.65 pour être TRÈS visible et présente.
    float opacity_growth = pow(real_height, 2.0);
    float smoke_alpha = clamp(smoke_pattern * middle_column_mask * smoke_trigger * opacity_growth, 0.0, 1.0) * 0.65;

    // --- 7. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(combined_heat * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(combined_heat * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(combined_heat * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 8. INCORPORATION PROGRESSIVE DU BROUILLARD DE SUIE ---
    // Absorption de la lumière arrière-plan (occlusion par la suie)
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.70));

    // Teinte évolutive : gris-bleu discret à la base, évoluant vers un gris charbon présent en haut
    vec3 smoke_base_color = vec3(0.14, 0.18, 0.25);
    vec3 smoke_top_color  = vec3(0.45, 0.47, 0.50);
    vec3 dynamic_smoke_body = mix(smoke_base_color, smoke_top_color, real_height) * (smoke_pattern * middle_column_mask * smoke_trigger);

    // Mélange final
    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * opacity_growth * 0.55);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}



void main_voronoi_2() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. AXE DE HAUTEUR RÉEL ---
    float real_height = 1.0 - (float(yy) / float(size.y));

    // --- 2. CALCUL DES CELLULES DE CONVECTION ATTÉNUÉES (MONTÉE PHYSIQUE) ---
    // CORRECTION SENS : Utiliser le signe "+" devant le temps redresse le flux vers le haut
    // Fréquence légèrement lissée (0.012) pour élargir les structures
    vec2 convection_uv = vec2(float(x) * 0.012, float(yy) * 0.012 + time * 2.5);

    vec2 voronoi = computeVoronoi(convection_uv, time);

    // CORRECTION VISIBILITÉ : On applique un smoothstep très large (0.0 à 0.85) sur la distance.
    // Cela supprime les bords durs et transforme les cercles opaques en nappes de brouillard vaporeuses.
    float convection_intensity = clamp(1.0 - voronoi.x, 0.0, 1.0);
    float smooth_convection = smoothstep(0.0, 0.85, convection_intensity);

    // Pulsation asynchrone adoucie pour que le bouillonnement soit subtil
    float cell_flicker = sin(time * 3.5 + voronoi.y * 12.5) * 0.15 + 0.85;
    float final_convection = smooth_convection * cell_flicker;

    // --- 3. PLASMA DE DISTORSION ARRIÈRE-PLAN ---
    float heat_scroll = time * 140.0;
    float plasma = computePlasma(float(x), float(yy) + heat_scroll, time, rnd, rnd2);
    float combined_heat = mix(plasma, final_convection - 0.5, 0.40);

    // --- 4. DISTORSIONS GÉOMÉTRIQUES ---
    float fire_distortion_x = combined_heat * 40.0;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0;

    // --- 5. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float distorted_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float distorted_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(distorted_x / float(scale_x)));
    int column = int(floor(distorted_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 6. MASQUES DE CONFINEMENT ET ATTÉNUATION CRITIQUE DE L'ALPHA ---
    float center_x = float(x) / float(size.x);
    float middle_column_mask = exp(-pow((center_x - 0.5) / 0.35, 2.0));

    // Zone d'émission au-dessus des flammes vives
    float smoke_trigger = smoothstep(0.35, 0.55, real_height);

    // CORRECTION OPACITÉ : On bride drastiquement le multiplicateur max à 0.40 (au lieu de 0.65).
    // Les volutes cessent d'être de gros pâtés sombres et deviennent translucides.
    float smoke_alpha = clamp(final_convection * middle_column_mask * smoke_trigger * real_height, 0.0, 1.0) * 0.40;

    // --- 7. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    // Composition émissive arrière-plan
    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(combined_heat * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(combined_heat * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(combined_heat * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 8. EFFET D'ABSORPTION ATTÉNUÉ ---
    // La fumée bloque la lumière de manière beaucoup plus douce (0.50 max au lieu de 0.85)
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_alpha * 0.50));

    // Teinte de la fumée vaporeuse et diluée
    vec3 smoke_base_color = vec3(0.15, 0.18, 0.24);
    vec3 smoke_top_color  = vec3(0.40, 0.42, 0.45);
    vec3 dynamic_smoke_body = mix(smoke_base_color, smoke_top_color, real_height) * (final_convection * middle_column_mask * smoke_trigger);

    vec3 final_rgb = soot_absorption + (dynamic_smoke_body * 0.40);

    // --- 9. OMBRES CELLULAIRES TRÈS ADOUCIES ---
    // Les ombres sur les bords de cellules sont gommées pour enlever l'effet de démarcation dure
    float edge_shadow = voronoi.x * middle_column_mask * smoke_trigger;
    final_rgb = mix(final_rgb, vec3(0.005, 0.008, 0.012), edge_shadow * 0.20 * real_height);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}












void main_voronoi_smoke() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    ivec2 size = imageSize(outputImage);

    if (x >= uint(size.x) || y >= uint(size.y)) return;

    uint yy = size.y - 1 - y;

    uint seed = x + yy * uint(size.x) + uint(cos(time * 0.05 + 0.01) * 1000.0);
    float rnd = pcg_hash(seed);
    uint seed2 = x + yy * uint(size.x) + uint(5. * sin(time * 0.05));
    float rnd2 = pcg_hash(seed2);

    // --- 1. VORONOI FLUIDE MAIS TRÈS CONTRASTÉ ---
    // Échelle intermédiaire pour avoir de grosses volutes dynamiques qui montent
    vec2 voronoi_uv = vec2(float(x) * 0.018, float(yy) * 0.018 + time * 3.0);
    float voronoi_dist = computeSmoothVoronoi(voronoi_uv, time);

    // Intensité continue (on vire les seuils brutaux qui faisaient des morceaux de calque)
    float voronoi_intensity = clamp(1.0 - (voronoi_dist * 1.2), 0.0, 1.0);

    // --- 2. PLASMA DE DISTORSION ARRIÈRE-PLAN ---
    float heat_scroll = time * 140.0;
    float plasma = computePlasma(float(x), float(yy) + heat_scroll, time, rnd, rnd2);
    float combined_heat = mix(plasma, voronoi_intensity - 0.5, 0.5);

    // --- 3. DISTORSIONS GÉOMÉTRIQUES ---
    float fire_distortion_x = combined_heat * 40.0;
    float fire_distortion_y = sin(combined_heat * 3.1415) * 15.0;

    // --- 4. LECTURE DE LA MATRICE DE FEU ---
    uint size_x  = fire_matrix[0];
    uint size_y  = fire_matrix[1];
    uint scale_x = fire_matrix[2];
    uint scale_y = fire_matrix[3];

    float distorted_x = clamp(float(x) + fire_distortion_x, 0.0, float(size_x * scale_x - 1));
    float distorted_yy = clamp(float(yy) + fire_distortion_y, 0.0, float(size_y * scale_y - 1));

    int row = int(floor(distorted_x / float(scale_x)));
    int column = int(floor(distorted_yy / float(scale_y)));

    vec4 fire_color = uint_to_rgba(palettes[fire_matrix[4 + row + column * size_x]]);

    // --- 5. LOGIQUE D'INTÉGRATION DU SMOG ET DES VOLUTES ---
    float real_height = 1.0 - (float(column) / float(size_y));

    float center_x = float(x) / float(size.x);
    // Large cône vertical pour que la fumée se déploie depuis le centre
    float middle_column_mask = exp(-pow((center_x - 0.5) / 0.32, 2.0));

    // Zone de naissance fluide au-dessus du cœur du brasier
    float smoke_trigger = smoothstep(0.35, 0.60, real_height);

    // --- 6. RENDU DU LOGO DOOM ---
    int r_offset = int(10.0 * rnd  * sin(0.001 * time * rnd));
    int b_offset = int(-10.0 * rnd2 * sin(0.0015 * time * rnd2));

    float logo_dist = fire_distortion_x * 0.6;
    float logo_r = imageLoad(doom_logo, ivec2(clamp(int(x) + r_offset + int(logo_dist), 0, size.x - 1), int(yy))).r;
    float logo_g = imageLoad(doom_logo, ivec2(clamp(int(x) + int(logo_dist),            0, size.x - 1), int(yy))).g;
    float logo_b = imageLoad(doom_logo, ivec2(clamp(int(x) + b_offset + int(logo_dist), 0, size.x - 1), int(yy))).b;

    vec4 doom_logo_color = vec4(logo_r, logo_g, logo_b, 0.0);
    float logo_mask = max(max(doom_logo_color.r, doom_logo_color.g), doom_logo_color.b);

    // --- 7. COMPOSITION DU LOGO ET DU FEU DE BASE ---
    vec4 plasma_color;
    plasma_color.r = 0.5 * sin(combined_heat * 3.1415) * 0.5 + 0.5;
    plasma_color.g = 0.25 * cos(combined_heat * 3.1415 + time * 0.005) * 0.5 + 0.5;
    plasma_color.b = 0.15 * sin(combined_heat * 3.1415 + 1.5) * 0.5 + 0.5;
    plasma_color.a = 1.0;

    vec3 final_logo = doom_logo_color.rgb * 2.0;
    if (logo_mask > 0.05) {
        final_logo += plasma_color.rgb * 0.8;
    }

    // Notre scène émissive (Feu + Logo)
    vec3 base_scene_rgb = fire_color.rgb + 1.5 * (0.1 + fire_color.rgb) * final_logo;

    // --- 8. INCORPORATION SOMBRE ET INTÉGRÉE DE LA FUMÉE (FINI LE MULTIPLIÉ SURFACE) ---
    // Au lieu de poser une couleur grise opaque, la fumée vient ASSOMBRIR le feu de manière sélective (Absorption).
    // Les bosses de Voronoi bloquent la lumière du brasier, créant des silhouettes vaporeuses.
    float smoke_density = voronoi_intensity * middle_column_mask * smoke_trigger * real_height;

    // On atténue la scène de base là où la fumée est dense (effet d'occlusion de la suie)
    vec3 soot_absorption = base_scene_rgb * (1.0 - (smoke_density * 0.75));

    // On ajoute une très légère lueur de suie froide (gris bleuté) uniquement en hauteur pour donner du volume
    vec3 smoke_body_color = vec3(0.20, 0.22, 0.28) * smoke_density * smoothstep(0.4, 0.9, real_height);

    // Fusion finale
    vec3 final_rgb = soot_absorption + smoke_body_color;

    // --- 9. OMBRAGE TRIDIMENSIONNEL CONTINU EN PROFONDEUR ---
    // Les creux du Voronoi génèrent des micro-ombres portées qui sculptent les volutes de l'intérieur
    float shadow_factor = (1.0 - voronoi_intensity) * middle_column_mask * smoke_trigger;
    final_rgb = mix(final_rgb, vec3(0.002, 0.004, 0.008), shadow_factor * 0.45 * real_height);

    imageStore(outputImage, ivec2(int(x), int(yy)), vec4(final_rgb, 1.0));
}















